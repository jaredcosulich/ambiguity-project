---
import Component from '../../components/BlogEmptyCard.astro';
import '../../styles/global.css';

// Isolation page for BlogEmptyCard — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/BlogEmptyCard. The launch-state subscribe card,
// linking to the Substack home.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: BlogEmptyCard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="width: 100%; max-width: 680px; padding: 48px;">
      <Component substackUrl="https://ambiguityproject.substack.com" />
    </div>
  </body>
</html>
