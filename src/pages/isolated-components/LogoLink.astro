---
import Component from '../../components/LogoLink.astro';
import { getSettings } from '../../lib/site';
import '../../styles/global.css';
const settings = getSettings();

// Isolation page for LogoLink — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/LogoLink. Site data (settings.json / nav.json)
// comes from the seeded sandbox, the same source the real pages read.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: LogoLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: 24px 32px; background: var(--navy);">
      <Component siteTitle={settings.siteTitle} />
    </div>
  </body>
</html>
