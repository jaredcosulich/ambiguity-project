---
import Component from '../../components/ToolsSection.astro';
import '../../styles/global.css';
import { getSettings } from '../../lib/site';
import { getCollection } from 'astro:content';
import { publishedEntries } from '@codeyam/cms/content';
import { sortByOrder, pickFirstByOrder } from '../../lib/contentOrder';
const s = getSettings();
const tools = sortByOrder(publishedEntries(await getCollection('tools')));

// Isolation page for ToolsSection — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/ToolsSection. Tools and the section copy come from the seeded sandbox; zero tools renders nothing visible.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: ToolsSection</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="width: 100%;">
      <Component tools={tools} heading={s.toolsHeading} allUrl={s.toolsAllUrl} />
    </div>
  </body>
</html>
