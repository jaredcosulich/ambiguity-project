---
import Component from '../../components/LibraryHeader.astro';
import '../../styles/global.css';

// Isolation page for LibraryHeader — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/LibraryHeader. The heading has no props; it is shown
// at the Library page's gutter width.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: LibraryHeader</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" class="wrap" style="width: 100%; padding-block: 48px;">
      <Component />
    </div>
  </body>
</html>
