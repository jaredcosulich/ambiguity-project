---
import Component from '../../components/LibraryGrid.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { publishedEntries } from '@codeyam/cms/content';
import { sortByOrder } from '../../lib/contentOrder';
const books = sortByOrder(publishedEntries(await getCollection('library')));

// Isolation page for LibraryGrid — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/LibraryGrid. Every seeded book in the grid at the
// Library page's gutter width.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: LibraryGrid</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" class="wrap" style="width: 100%; padding-block: 48px;">
      <Component books={books} />
    </div>
  </body>
</html>
