---
import Component from '../../components/BlogSection.astro';
import '../../styles/global.css';
import { getSettings } from '../../lib/site';
import { getSubstackPosts } from '../../lib/substack';

// Isolation page for BlogSection — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/BlogSection. Posts and the Substack URL come from
// the seeded snapshot and settings, so each scenario's seed picks the state (many posts,
// one post, or none yet).
const settings = getSettings();
const posts = getSubstackPosts();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: BlogSection</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="width: 100%;">
      <Component posts={posts} substackUrl={settings.substackUrl} siteTitle={settings.siteTitle} />
    </div>
  </body>
</html>
