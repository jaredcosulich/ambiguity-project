---
import Component from '../../components/ToolCard.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { publishedEntries } from '@codeyam/cms/content';
import { sortByOrder, pickFirstByOrder } from '../../lib/contentOrder';
const tool = pickFirstByOrder(publishedEntries(await getCollection('tools')));

// Isolation page for ToolCard — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/ToolCard. The first seeded tool on the sage band.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: ToolCard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="width: 100%; max-width: 760px; padding: 32px; background: var(--sage-tint);">
      {tool && <Component id={tool.id} name={tool.data.name} description={tool.data.description} url={tool.data.url} />}
    </div>
  </body>
</html>
