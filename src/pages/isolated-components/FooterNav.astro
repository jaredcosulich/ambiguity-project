---
import Component from '../../components/FooterNav.astro';
import { getNav } from '../../lib/site';
import { toNavLinks } from '../../lib/navLinks';

const links = toNavLinks(getNav().items);
import '../../styles/global.css';

// Isolation page for FooterNav — codeyam screenshots the #codeyam-capture wrapper by
// navigating to /isolated-components/FooterNav. Site data (settings.json / nav.json)
// comes from the seeded sandbox, the same source the real pages read.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: FooterNav</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: 24px 32px; font-family: var(--sans); font-size: 13px;">
      <Component links={links} />
    </div>
  </body>
</html>
