---
import Component from '../../components/SectionAnchor.astro';
import '../../styles/global.css';

// Isolation page for SectionAnchor — codeyam screenshots the #codeyam-capture
// wrapper by navigating to /isolated-components/SectionAnchor. The anchor is
// empty on the live home page until a section plan fills it, so this page
// slots in a bracket label to show content passes through and the dashed
// outline marks the anchor's bounds.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: SectionAnchor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@400;600&display=swap" />
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="width: 100%; max-width: 720px; padding: 24px; outline: 1px dashed var(--muted);">
      <Component id="books" label="Books">
        <p class="label">Books</p>
      </Component>
    </div>
  </body>
</html>
