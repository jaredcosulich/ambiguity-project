---
// A free-form CMS page (About, the book page): title over the markdown body,
// which arrives as the default slot.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<article class="page wrap" data-cms-entry={`pages/${id}`}>
  <h1 data-cms-field="title">{title}</h1>
  <div class="page-body" data-cms-body>
    <slot />
  </div>
</article>

<style>
  .page { display: flex; flex-direction: column; gap: 28px; max-width: calc(760px + 2 * var(--gutter)); padding-block: var(--section-y); }
  .page h1 { font-size: clamp(32px, 3.6vw, 52px); line-height: 1.08; letter-spacing: -0.02em; color: var(--navy); }
  .page-body { font-size: 18px; line-height: 1.6; color: var(--body); }
  .page-body :global(p + p) { margin-top: 1em; }
</style>
