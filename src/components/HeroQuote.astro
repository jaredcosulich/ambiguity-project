---
// One quote in the hero aside (from the `quotes` collection).
interface Props {
  text: string;
  attribution?: string;
}

const { text, attribution } = Astro.props;
---

<aside class="quotes" aria-label="Quote">
  <figure class="quote">
    <blockquote>
      <p>{text}</p>
    </blockquote>
    {attribution && <figcaption>{attribution}</figcaption>}
  </figure>
</aside>

<style>
  .quote { margin: 0; }
  .quote blockquote { margin: 0; position: relative; padding-top: 30px; }
  .quote blockquote::before { content: "\201C"; position: absolute; left: -4px; top: -18px; font-size: 72px; line-height: 1; color: var(--salmon); }
  .quote p { font-size: clamp(18px, 1.6vw, 23px); line-height: 1.45; font-style: italic; color: rgba(255,255,255,0.92); overflow-wrap: anywhere; }
  .quote figcaption { margin-top: 14px; font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.72); }
  @media (max-width: 960px) {
    .quotes { max-width: 560px; }
  }
</style>
