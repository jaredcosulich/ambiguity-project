---
// One book in the Books section: cover beside its copy and links. The first
// book also carries the section's "Books" bracket label.
import BookCover from './BookCover.astro';
import { withBase } from '../lib/base';

interface Book {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  cover?: string;
  coverAlt?: string;
  blurb?: string;
  primaryLabel?: string;
  primaryUrl?: string;
  secondaryLabel?: string;
  secondaryUrl?: string;
}

interface Props {
  id: string;
  book: Book;
  showLabel?: boolean;
}

const { id, book: b, showLabel = false } = Astro.props;
const headingId = `book-${id}-h`;
---

<article class="book wrap" aria-labelledby={headingId} data-cms-entry={`books/${id}`}>
  <BookCover title={b.title} cover={b.cover} coverAlt={b.coverAlt} />
  <div class="book-copy">
    {showLabel && <p class="label">Books</p>}
    {b.eyebrow && <p class="eyebrow" data-cms-field="eyebrow">{b.eyebrow}</p>}
    <h2 id={headingId} data-cms-field="title">{b.title}</h2>
    {b.subtitle && <p class="subtitle" data-cms-field="subtitle">{b.subtitle}</p>}
    {b.blurb && <p class="blurb" data-cms-field="blurb">{b.blurb}</p>}
    {
      (b.primaryUrl || b.secondaryUrl) && (
        <div class="actions">
          {b.primaryUrl && (
            <a class="btn btn-lg" href={withBase(b.primaryUrl)} data-cms-field="primaryLabel">
              {b.primaryLabel ?? 'Learn more'}
            </a>
          )}
          {b.secondaryUrl && (
            <a class="more" href={withBase(b.secondaryUrl)} data-cms-field="secondaryLabel">
              {b.secondaryLabel ?? 'About the book →'}
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .book { display: flex; align-items: center; justify-content: center; gap: clamp(40px, 7vw, 90px); padding-block: var(--section-y); color: var(--plum); }
  .book + .book { padding-top: 0; }
  .book-copy { display: flex; flex-direction: column; max-width: 560px; }
  .book-copy .eyebrow { margin-top: 22px; color: #6B3E32; }
  .book-copy h2 { margin-top: 10px; font-size: clamp(34px, 3.8vw, 54px); line-height: 1.04; letter-spacing: -0.02em; }
  .book-copy .subtitle { margin-top: 11px; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.3; font-style: italic; color: #3B2E40; }
  .book-copy .blurb { margin-top: 22px; font-size: 16px; line-height: 1.55; color: #3B2E40; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 29px; }
  .book .btn { background: var(--plum); color: #fff; }
  .book .more { color: var(--plum); }
  @media (max-width: 860px) {
    .book { flex-direction: column; text-align: left; }
    .book-copy { max-width: 620px; }
  }
</style>
